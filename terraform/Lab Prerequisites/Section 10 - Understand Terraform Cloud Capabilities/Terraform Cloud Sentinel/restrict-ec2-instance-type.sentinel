# Require EC2 instance types from an allowed list
import "tfplan-functions" as plan

# Allowed EC2 Instance Types
allowed_types = ["t3.micro", "t2.small", "t2.medium"]

# All aws_instance resources in the plan
allEC2Instances = plan.find_resources("aws_instance")

# Instances whose "instance_type" is not in the allowed list (prints messages)
violatingEC2Instances = plan.filter_attribute_not_in_list(
  allEC2Instances,
  "instance_type",
  allowed_types,
  true,
)

# Main rule: zero violations
main = rule { length(violatingEC2Instances["messages"]) is 0 }
